# ==========================================================================
#  .htaccess - strona gabinetu na wlasnej domenie (Apache / LiteSpeed)
#
#  Workflow kopiuje ten plik do katalogu glownego strony przy kazdej wysylce
#  na hosting (job "hosting" w .github/workflows/pages.yml). Na GitHub Pages
#  nie trafia - tam nie dziala.
#
#  Jesli po pierwszej wysylce strona zwroci HTTP 500: hosting nie zna ktorejs
#  dyrektywy. Usuwaj sekcje od konca, po jednej, az strona wroci - najczesciej
#  winne sa Options albo brak modulu mod_headers.
# ==========================================================================

# --- 1. Strona glowna katalogu i strona bledu 404 --------------------------
DirectoryIndex index.html
ErrorDocument 404 /404.html

# --- 2. Brak listowania katalogow -----------------------------------------
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# --- 3. Wymuszenie HTTPS i adres bez "www." --------------------------------
# Certyfikat (Let's Encrypt w panelu hostingu) musi byc wydany, zanim domena
# zacznie wskazywac na ten serwer - inaczej przegladarka pokaze blad
# certyfikatu. .well-known/ zostaje bez przekierowan (weryfikacja certyfikatu).
#
# CERTYFIKATU JESZCZE NIE MA (OVH wyda go dopiero po zmianie DNS na OVH),
# wiec wymuszenie HTTPS jest wylaczone, a "www." prowadzi na http://.
# Po wydaniu certyfikatu: odkomentowac blok HTTPS i w regule "www."
# zamienic http:// na https:// (docs/HOSTING.md, "OVHcloud").
#  RewriteCond %{REQUEST_URI} !^/\.well-known/
#  RewriteCond %{HTTPS} !=on
#  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
#  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ http://%1/$1 [R=301,L]

# --- 4. Przekierowania ze starej strony ------------------------------------
# Stara strona (2011-2026) miala adresy .php. Sa w wynikach Google, w zakladkach
# pacjentow i w linkach z innych stron - bez 301 ich wartosc przepada,
# a pacjent trafia na 404. Plikow starej strony na serwerze nie ma i nie trzeba.
  RewriteRule ^index\.php$                 /                        [R=301,L]
  RewriteRule ^uslugi\.php$                /uslugi/                 [R=301,L]
  RewriteRule ^cennik\.php$                /cennik/                 [R=301,L]
  RewriteRule ^nowosci\.php$               /wyposazenie/            [R=301,L]
  RewriteRule ^galeria\.php$               /galeria/                [R=301,L]
  RewriteRule ^kontakt\.php$               /kontakt/                [R=301,L]
  RewriteRule ^polityka-prywatnosci\.pdf$  /polityka-prywatnosci/   [R=301,L]
  RewriteRule ^media/cennik[^/]*\.pdf$     /cennik/                 [R=301,L]
  RewriteRule ^galeria/foto/               /galeria/                [R=301,L]
  RewriteRule ^media/                      /galeria/                [R=301,L]
</IfModule>

# --- 5. Kompresja ---------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/manifest+json image/svg+xml
</IfModule>

# --- 6. Pamiec podreczna przegladarki ------------------------------------
# Arkusz, skrypt i zdjecia przetworzone przez Hugo maja odcisk w nazwie pliku
# (nowa wersja = nowa nazwa), wiec moga lezec w pamieci przegladarki dlugo.
# HTML krotko - zmiana w panelu ma byc widoczna od razu.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 hour"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 month"
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
</IfModule>

# --- 7. Naglowki bezpieczenstwa i prywatnosci ----------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS wlaczyc dopiero, gdy HTTPS dziala stabilnie przez kilka dni
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# --- 8. Typy MIME, ktorych starsze serwery moga nie znac ------------------
<IfModule mod_mime.c>
  AddType image/avif                  .avif
  AddType image/webp                  .webp
  AddType application/manifest+json   .webmanifest
</IfModule>
